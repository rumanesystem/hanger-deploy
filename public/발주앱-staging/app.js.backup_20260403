const PRICE_HIDDEN = new Set(['2단서랍장+손잡이','3단서랍장+손잡이','4단서랍장+손잡이']);

let priceSettingsSearch='',priceSettingsOnlyNull=false;
function renderPriceSettings(){
  if(!requireAdmin())return;
