    const amt=typeof rawAmt==='number'?rawAmt:parseInt((rawAmt+'').replace(/[^0-9]/g,'')||'0');
    statsMap[uid].amount+=amt||0;
    if(!statsMap[uid].lastDate||o.orderDate>statsMap[uid].lastDate)statsMap[uid].lastDate=o.orderDate;
