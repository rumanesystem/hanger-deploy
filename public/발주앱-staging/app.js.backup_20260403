function printOrder(order){
  // html2canvas 없이 순수 HTML+CSS 방식으로 인쇄
  // 1) 발주서 HTML을 off-screen div에 렌더링 → 높이 측정
  // 2) A4 높이 대비 zoom 계산 → #print-area에 삽입 → window.print()
  const printBtn=document.getElementById('print-order-btn');
  if(printBtn){printBtn.disabled=true;printBtn.innerHTML='<i class="fas fa-spinner fa-spin"></i> 준비 중...';}
  const resetBtn=()=>{if(printBtn){printBtn.disabled=false;printBtn.innerHTML='<i class="fas fa-print"></i> 인쇄';}};

  try{
    // 높이 측정용 임시 div (off-screen)
    const measure=document.createElement('div');
    measure.style.cssText='position:fixed;left:-10000px;top:0;width:794px;padding:24px 32px;box-sizing:border-box;background:#fff;z-index:-1;';
    measure.innerHTML=renderOrderDocument(order);
    document.body.appendChild(measure);

    // 2프레임 대기 → 렌더링 완료 후 높이 측정
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      const contentH=measure.scrollHeight||1122;
      document.body.removeChild(measure);

      // A4 portrait: 297mm = 1122px (96dpi 기준), 여백 0
      const a4H=1122;
      const zoom=contentH>a4H?(a4H/contentH):1;

      // #print-area에 발주서 HTML 삽입 (zoom 적용)
      const printArea=document.getElementById('print-area');
      const inner=document.createElement('div');
      inner.style.cssText=`width:794px;padding:24px 32px;box-sizing:border-box;background:#fff;zoom:${zoom.toFixed(4)};`;
      inner.innerHTML=renderOrderDocument(order);
      printArea.innerHTML='';
      printArea.appendChild(inner);

      const cleanup=()=>{
        printArea.innerHTML='';
        window.removeEventListener('afterprint',cleanup);
      };
      window.addEventListener('afterprint',cleanup);

      resetBtn();
      window.print();
    }));
  }catch(err){
    console.error('인쇄 준비 오류:',err);
    resetBtn();
    toast('인쇄 준비 중 오류가 발생했습니다.','error');
  }
}

