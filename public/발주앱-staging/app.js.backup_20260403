let stockLogFilter='',stockLogType='',stockLogItem='',stockLogDateFrom='',stockLogDateTo='';
let stockLogPage=1; // 재고 기록 페이지 (독립 페이지)
let invLogPage=1;   // 재고 관리 내 기록 섹션 페이지
