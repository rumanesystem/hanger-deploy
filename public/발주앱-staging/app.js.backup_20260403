      const name=btn.dataset.name;
      const inp=document.querySelector(`.price-edit-input[data-name="${name}"]`);
      if(!inp)return;
      const val=inp.value.trim();
      const price=val===''?null:parseInt(val);
      if(val!==''&&(isNaN(price)||price<0)){toast('단가는 0 이상의 숫자 또는 빈칸(미정)으로 입력해주세요.','error');return;}
      const ps=getPriceSettings();
      const idx=ps.findIndex(p=>p.name===name);
      if(idx!==-1)ps[idx].price=price;
      DB.set('price_settings',ps);
      toast(`${PRICE_DISPLAY_LABEL[name]||name} 단가가 저장되었습니다.`,'success');
      renderPriceSettings();

      // ─── 이카운트 ERP 단가 동기화 (저장된 품목코드 우선) ───
      if(price!==null && window._FN){
        // 1) 단가관리 price_settings의 prodCd 확인
        // 2) 없으면 품목 마스터 items의 prodCd 확인
        const psForSync=getPriceSettings();
        const psItem=psForSync.find(p=>p.name===name);
        const itemsForSync=DB.get('items',[]);
        const itemForSync=itemsForSync.find(i=>i.name===name);
        const prodCdStr=(psItem?.prodCd||itemForSync?.prodCd||'');
        const prodCds=prodCdStr.split(',').map(c=>c.trim()).filter(Boolean);

        if(prodCds.length>0){
          // 저장된 품목코드로 직접 업데이트
          try{
            toast(`이카운트 단가 반영 중... (${prodCds.length}개 코드)`,'info');
            await Promise.all(prodCds.map(cd=>window._FN.updateEcountPrice({prodCd:cd,price})));
            toast(`✅ 이카운트 반영 완료 — ${PRICE_DISPLAY_LABEL[name]||name} ${price.toLocaleString()}원 (${prodCds.length}개)`,'success');
          }catch(e){
            toast('이카운트 연동 실패: '+(e?.message||String(e)),'error');
            console.error('[이카운트 단가 연동]',e);
          }
        }else{
          // 코드 미설정 시 안내만 표시 (이카운트 호출 없음)
          toast(`⚠️ "${PRICE_DISPLAY_LABEL[name]||name}" 품목의 이카운트 코드가 미설정입니다. 품목 마스터에서 코드를 입력해주세요.`,'warning');
        }
      }
    });
  });

  // ─── 이카운트 코드 저장 (단가관리 화면) ───────────────────
  document.querySelectorAll('.price-prodcd-save-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const name=btn.dataset.name;
      const inp=document.querySelector(`.price-prodcd-input[data-name="${name}"]`);
      if(!inp)return;
      const val=inp.value.trim();
      const ps=getPriceSettings();
      const idx=ps.findIndex(p=>p.name===name);
